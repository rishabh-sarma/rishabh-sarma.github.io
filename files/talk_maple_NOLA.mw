<Group labelreference="L61" drawlabel="true" applyint="true" applyrational="true" applyexponent="false">
<Input><Text-field prompt="&gt; " style="Maple Input" layout="Normal">check_alg_step1:=proc(p,m,nL) 
  local logset,n: 
  # check that each jn-func correspoding to each nvec in nL 
  # satisfies the modularity conditions of Theorem 3.1 
  logset:={seq(check_jpnz_modularity(p,m,n), n in nL)}: 
  if logset={true} then 
     RETURN(true): 
  else 
     print(&quot;nL=&quot;,nL); 
     for n in nL do  
     print(n, check_jpnz_modularity(p,m,n));               
     od: 
     RETURN(false): 
  fi: 
end: </Text-field>
</Input>
</Group>
