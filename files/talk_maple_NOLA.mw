<Input><Text-field prompt="&gt; " style="Maple Input" layout="Normal">Lpms:=proc(p,m,s) 
      local x,n: 
      if s=0 then 
          if member(p,{5,7}) then x:=0 else x:=-1/24/p*(p-5)*(p-7): fi: 
      else 
          if numer(s)=1 then   
             n:=denom(s): 
             if n&lt;(p-1)/6 then x:=-3/2/p*( (p-1)/6 -n)*((p+1)/2-n): else x:=0: fi: 
           else 
              n:=numer(s): 
              if m=0 or numtheory[legendre](-24*m,p)=-1 then x:=(p^2-1)/24/p: else 
                x:=1/2-3/2/p: 
              fi: 
            fi: 
      fi: 
 RETURN(x): 
 end: 
#----------------------------------------------------------- 
 KjLmps:=proc(p,m,s,n) 
    local x1,x2,a,c: 
     # 
     x1:=Lpms(p,m,s): 
     a:=numer(s): c:=denom(s): 
     x2:=ncuspord(p,n,a,c): 
     RETURN(x1-x2): 
 end: </Text-field>
</Input>
</Group>
