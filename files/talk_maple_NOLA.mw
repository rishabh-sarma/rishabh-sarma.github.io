<Input><Text-field prompt="&gt; " style="Maple Input" layout="Normal">pirp:=proc(nv,r,p) 
  local n0,n1,piri,newn1,j,newnv,k: 
  n0:=nv[1]: 
  n1:=Array(1 .. (p-1)/2): for k from 1 to (p-1)/2 do n1[k]:=nv[k+1]: od: 
  piri:=(r1,i)-&gt;abs(mods(i/r1,p)): 
  newn1:=[seq(n1[piri(r,j)],j=1..(p-1)/2)]: 
  newnv:=[n0,op(newn1)]: 
RETURN(newnv): 
end: </Text-field>
</Input>
</Group>
