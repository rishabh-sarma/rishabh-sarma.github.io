<Group labelreference="L2111" drawlabel="true" applyint="true" applyrational="true" applyexponent="false">
<Input><Text-field prompt="&gt; " style="Maple Input" layout="Normal">PHIpa:=proc(p,a,T) 
  local P,n: 
  if 6*a&lt;p then 
     P:=add(q^(p*n^2)/aqprod(q^a,q^p,n+1)/aqprod(q^(p-a),q^p,n),n=0..T): 
  else 
     P:=-1 + add(q^(p*n^2)/aqprod(q^a,q^p,n+1)/aqprod(q^(p-a),q^p,n),n=0..T): 
  fi: 
  RETURN(P): 
  end: </Text-field>
</Input>
</Group>
