<Group labelreference="L78" drawlabel="true" applyint="true" applyrational="true" applyexponent="false">
<Input><Text-field prompt="&gt; " style="Maple Input" layout="Normal">minord_LHSminusRHS_at_s:=proc(p,m,s,n,nL) 
    local set1,set2,set3,nv: 
    if m&lt;&gt;0 then 
      set1:={KjLmps(p,m,s,n)}: 
      set2:={seq(ncuspord(p,nv,numer(s),denom(s)),nv in nL)}: 
      set3:= set1 union set2: 
    else 
      set1:={Lpms(p,m,s)}: 
      set2:={seq(ncuspord(p,nv,numer(s),denom(s)),nv in nL)}: 
      set3:= set1 union set2: 
    fi: 
 RETURN(min(set3)); 
 end: </Text-field>
</Input>
