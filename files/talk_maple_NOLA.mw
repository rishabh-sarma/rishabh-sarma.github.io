     if m=0 then 
<Font encoding="UTF-8">        printf(&quot;and _topq + 1 &gt; -_B + GAMMA1INDEX/12 = %a + %a = %a \134n&quot;,</Font>-BB,GAM1IND/12,-BB+GAM1IND/12); 
     else 
<Font encoding="UTF-8">        printf(&quot;and _topq + 1 &gt; -_B = %a \134n&quot;,</Font>-BB); 
    fi: </Text-field>
</Input>
<Input><Text-field prompt="&gt; " style="Maple Input" layout="Normal">print(_K[p,m]=SYMrelpm);  
    RETURN(cofs): 
   fi:</Text-field>
