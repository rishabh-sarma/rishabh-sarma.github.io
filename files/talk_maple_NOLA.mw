<Group labelreference="L74" drawlabel="true" applyint="true" applyrational="true" applyexponent="false">
<Input><Text-field prompt="&gt; " style="Maple Input" layout="Normal"> LHSRHScuspORDtable:=proc(p,m,k0,nL,newnL) 
 local b,symcusp,a,c,w,LORD,set2,RORD,LRORD,nv,n,cuspsp1,s; 
    b:=0: 
    cuspsp1:=cuspmake1(p): 
    print(&quot;TABLE : ORD lower bounds&quot;); 
    print(_cusp, _width, _ORD_LHS, _ORD_RHS,_ORD_LHS_minus_RHS); 
    if m&lt;&gt;0 then 
       n:=nL[k0]: 
       for symcusp in cuspsp1 do 
         if symcusp&lt;&gt;[1,0] then 
             a:=symcusp[1]: c:=symcusp[2]: 
   	  w:=cuspwid1(a,c,p): 
             s:=a/c: 
   	  LORD:=ceil(KjLmps(p,m,s,n)*w): 
       	  set2:={seq(ncuspord(p,nv,a,c),nv in newnL)}: 
             RORD:=ceil(min(set2)*w): 
             LRORD:=ceil(min(LORD,RORD)): 
       	  print(a/c, w, LORD,RORD, LRORD); 
         fi: 
       od: 
   else 
       for symcusp in cuspsp1 do 
         if symcusp&lt;&gt;[1,0] then 
             a:=symcusp[1]: c:=symcusp[2]: 
   	  w:=cuspwid1(a,c,p): 
             s:=a/c: 
   	  LORD:=ceil(Lpms(p,m,s)*w): 
       	  set2:={seq(ncuspord(p,nv,a,c),nv in newnL)}: 
             RORD:=ceil(min(set2)*w): 
             LRORD:=ceil(min(LORD,RORD)): 
       	  print(a/c, w, LORD,RORD, LRORD); 
         fi: 
       od: 
   fi: 
RETURN(): 
end: </Text-field>
</Input>
</Group>
