<Input><Text-field prompt="&gt; " style="Maple Input" layout="Normal">B_const:=proc(p,m,n,nL) 
    local cuspsp1,b,symcusp,a,c,minord: 
    cuspsp1:=cuspmake1(p): 
    b:=0: 
       for symcusp in cuspsp1 do 
         if symcusp&lt;&gt;[1,0] then 
             a:=symcusp[1]: c:=symcusp[2]: 
             minord:=minord_LHSminusRHS_at_s(p,m,a/c,n,nL): 
             b:=b + ceil(minord*cuspwid1(a,c,p)): 
          fi: 
       od: 
RETURN(b): 
end:</Text-field>
